{
  "name": "jinlongyu-fulfillment-agent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:pages": "GITHUB_PAGES=true pnpm exec tsc --noEmit && GITHUB_PAGES=true pnpm exec vite build",
    "preview": "vite preview",
    "preview:pages": "pnpm build:pages && vite preview --base /tezign-jinlongyu/"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
